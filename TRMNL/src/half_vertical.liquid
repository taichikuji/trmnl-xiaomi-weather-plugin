{% if available %}
<div class="layout layout--col gap--xsmall lg:gap--medium">
  <div class="flex flex--col flex--center grow w--full">
    {% render 'weather_current', now: now, days: days, size: 'value--xlarge portrait:value--xxxlarge portrait:w--full lg:value--xxxlarge', row_class: 'portrait:flex--col-reverse portrait:w--full' %}
  </div>
  <div class="outline p--2 flex flex--row portrait:flex--col flex--between gap--xsmall w--full">
    <span class="label">Sunrise {{ sunrise }}</span>
    <span class="label">Sunset {{ sunset }}</span>
  </div>
  <div class="outline p--2 flex flex--row flex--center-x w--full">
    <span class="label">Wind {{ now.wind }} {{ now.wind_unit | escape }}</span>
  </div>
  <div class="outline p--1 lg:p--4 flex flex--col gap--none w--full">
    {% render 'weather_forecast', days: days, count: 3, portrait_compact: true %}
  </div>
  {% if stale %}<span class="label label--outline w--full">Old observation · {{ observed_date }}</span>
  {% elsif alert_count > 0 %}<span class="label label--filled w--full" data-clamp="1">{{ alert_count }} provider alerts · {{ alert_title | escape }}</span>{% endif %}
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
