{% if available %}
<div class="layout layout--col layout--top gap--xsmall lg:gap--small">
  {% if stale %}{{ provider_notice }}{% endif %}
  <div class="grid grid--cols-12 portrait:grid--cols-1 gap--xsmall lg:gap--small grow">
    <div class="col--span-6 portrait:col--span-1 flex flex--col gap--xsmall lg:gap--small self--stretch portrait:grid portrait:grid--cols-2">
      <div class="flex flex--col flex--center grow w--full">
        {% render 'weather_current', now: now, days: days, size: 'value--xxlarge portrait:w--full lg:value--giga lg:portrait:value--xxxlarge', large_details: true, icon_class: 'w--20 h--20 lg:w--40 lg:h--40 lg:portrait:w--24 lg:portrait:h--24', row_class: 'portrait:flex--col-reverse portrait:w--full' %}
      </div>
      {% if stale == false and alert_count > 0 %}
      <div class="w--full portrait:col--span-2 portrait:order--3">{{ provider_notice }}</div>
      {% endif %}
      <div class="grid grid--cols-2 gap--xsmall lg:gap--small w--full no-shrink portrait:self--center portrait:order--2">
        <div class="outline p--2 flex flex--col gap--none">
          <span class="label">WIND</span>
          <span class="label">{{ now.wind }} {{ now.wind_unit | escape }} {{ now.wind_direction }}</span>
        </div>
        <div class="outline p--2 flex flex--col gap--none">
          <span class="label">HUMIDITY</span>
          <span class="label">{{ now.humidity }} · UV {{ now.uv }}</span>
        </div>
        <div class="outline p--2 flex flex--row flex--between col--span-2 gap--xsmall">
          <span class="label">Sunrise {{ sunrise }}</span>
          <span class="label">Sunset {{ sunset }}</span>
        </div>
      </div>
    </div>
    <div class="col--span-6 portrait:col--span-1 outline p--1 lg:p--4 flex flex--col gap--none">
      {% render 'weather_forecast', days: days, count: 5, fahrenheit: fahrenheit, large_details: true, icon_class: 'w--9 h--9 lg:w--14 lg:h--14 lg:portrait:w--12 lg:portrait:h--12' %}
    </div>
  </div>
  <div class="outline p--2 lg:p--4 flex flex--col flex--center gap--none w--full no-shrink">
    {% if hours.size > 0 %}
    {% assign portrait_hours = hours.size | at_most: 8 %}
    <div class="grid grid--cols-{{ hours.size }} portrait:grid--cols-{{ portrait_hours }} lg:portrait:grid--cols-{{ hours.size }} gap--xsmall">
      {% for hour in hours %}
      <div class="flex flex--col flex--center gap--none{% if forloop.index > portrait_hours %} portrait:hidden lg:portrait:flex{% endif %}">
        <span class="label lg:label--large">{{ hour.time }}</span>
        <img class="w--9 h--9 lg:w--14 lg:h--14 lg:portrait:w--12 lg:portrait:h--12" src="{{ hour.icon_url }}" alt="{{ hour.condition | escape }}">
        <span class="value value--xsmall lg:value--small lg:portrait:value--xsmall">{{ hour.temperature }}</span>
      </div>
      {% endfor %}
    </div>
    {% else %}<span class="label">Hourly forecast unavailable</span>{% endif %}
  </div>
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
