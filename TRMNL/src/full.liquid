{% if available %}
<div class="layout layout--col gap--distribute">
  <div class="flex flex--row flex--between w--full">
    <span class="title title--large lg:title--xxlarge grow" data-clamp="1">{{ city | escape }}</span>
    <span class="label label--large no-shrink">{{ date_label | escape }}</span>
  </div>
  {{ provider_notice }}
  <div class="grid grid--cols-12 gap--large">
    <div class="col--span-5 flex flex--col flex--left gap--small">
      <div class="flex flex--row flex--center-y gap--small w--full">
        <span class="value value--xxxlarge lg:value--mega" data-fit-value="true">{{ now.temperature }}</span>
        <div class="w--24 h--24 lg:w--36 lg:h--36 no-shrink"><img class="w--full h--full" src="{{ now.icon_url }}" alt="{{ now.condition | escape }}"></div>
      </div>
      <span class="title lg:title--large w--full" data-clamp="1">{{ now.condition | escape }}</span>
      <span class="label">Feels {{ now.feels_like }}{% if days.size > 0 %} · High {{ days[0].high }} / Low {{ days[0].low }}{% endif %}</span>
      <div class="flex flex--row gap--medium">
        <span class="label">Wind {{ now.wind }} {{ now.wind_unit | escape }} {{ now.wind_direction }}</span>
        <span class="label">Humidity {{ now.humidity }}</span>
      </div>
    </div>
    <div class="col--span-7 flex flex--col gap--small flex--between border--v-1 pl--3">
      <div class="flex flex--row flex--between w--full">
        <span class="label text--uppercase text--bold">The next hours</span>
        <span class="label">{{ chart.low }} — {{ chart.high }}</span>
      </div>
      {{ hourly_chart }}
      {% if hours.size > 0 %}
      <div class="grid grid--cols-6 gap--small">
        {% for hour in hours %}
        <div class="flex flex--col flex--center gap--none">
          <span class="label">{{ hour.time }}</span>
          <span class="value value--xsmall lg:value--small">{{ hour.temperature }}</span>
          <div class="w--7 h--7 lg:w--10 lg:h--10"><img class="w--full h--full" src="{{ hour.icon_url }}" alt="{{ hour.condition | escape }}"></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      <div class="flex flex--row flex--between w--full pt--1">
        <span class="label">Sunrise {{ sunrise }} · Sunset {{ sunset }}</span>
        <span class="label">UV {{ now.uv }}</span>
      </div>
    </div>
  </div>
  <div class="flex flex--col gap--small w--full pt--1">
    <div class="divider"></div>
    <div class="flex flex--row flex--between w--full">
      <span class="label text--uppercase text--bold">The coming days</span>
      <span class="label label--small">High / low · Precipitation chance</span>
    </div>
    {% if days.size > 0 %}
    <div class="grid grid--cols-5 gap--small">
      {% for day in days %}
      <div class="flex flex--col flex--left gap--small p--1 {% if forloop.first %}bg--gray-75{% endif %}">
        <div class="flex flex--row flex--between w--full">
          <span class="label text--bold">{{ day.label }}</span>
          <span class="label">{{ day.date }}</span>
        </div>
        <div class="flex flex--row flex--between w--full">
          <div class="w--9 h--9 lg:w--14 lg:h--14"><img class="w--full h--full" src="{{ day.icon_url }}" alt="{{ day.condition | escape }}"></div>
          <div class="flex flex--row flex--center-y gap--small">
            <span class="value value--small lg:value--base">{{ day.high }}</span>
            <span class="label label--large">{{ day.low }}</span>
          </div>
        </div>
        <span class="label">Precip. {{ day.rain }}</span>
      </div>
      {% endfor %}
    </div>
    {% else %}<span class="label">Daily forecast unavailable</span>{% endif %}
  </div>
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
