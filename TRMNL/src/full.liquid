{% if available %}
<div class="layout layout--col gap--xsmall lg:gap--medium">
  <div class="flex flex--row flex--between w--full">
    <span class="title title--large grow" data-clamp="1">{{ city | escape }}</span>
    <span class="label no-shrink">{{ date_label | escape }} · {{ unit }}</span>
  </div>
  {{ provider_notice }}
  <div class="grid grid--cols-12 portrait:grid--cols-1 gap--small lg:gap--large grow">
    <div class="col--span-5 portrait:col--span-1 flex flex--col gap--xsmall flex--between portrait:grid portrait:grid--cols-2">
      {% render 'weather_current', now: now, days: days, size: 'value--xlarge lg:value--mega' %}
      <div class="grid grid--cols-2 gap--xsmall">
        <div class="outline p--2 flex flex--col gap--none">
          <span class="label label--small">WIND</span>
          <span class="label">{{ now.wind }} {{ now.wind_unit | escape }} {{ now.wind_direction }}</span>
        </div>
        <div class="outline p--2 flex flex--col gap--none">
          <span class="label label--small">HUMIDITY</span>
          <span class="label">{{ now.humidity }} · UV {{ now.uv }}</span>
        </div>
        <div class="outline p--2 flex flex--row flex--between col--span-2 gap--xsmall">
          <span class="label">Sunrise {{ sunrise }}</span>
          <span class="label">Sunset {{ sunset }}</span>
        </div>
      </div>
    </div>
    <div class="col--span-7 portrait:col--span-1 outline p--2 lg:p--4 flex flex--col gap--xsmall flex--between">
      {% render 'weather_forecast', days: days, count: 5 %}
    </div>
  </div>
  <div class="outline p--2 lg:p--4 flex flex--col gap--xsmall w--full no-shrink">
    <div class="flex flex--row flex--between w--full">
      <span class="label label--small">HOURLY FORECAST</span>
      <span class="label label--small">Low {{ chart.low }} · High {{ chart.high }}</span>
    </div>
    {% if hours.size > 0 %}
    <div class="grid grid--cols-3 portrait:grid--cols-1 gap--small">
      <div class="col--span-1">{{ hourly_chart }}</div>
      <div class="col--span-2 portrait:col--span-1">
        <div class="grid grid--cols-6 gap--xsmall">
          {% for hour in hours %}
          <div class="flex flex--col flex--center gap--none">
            <span class="label label--small">{{ hour.time }}</span>
            <img class="w--5 h--5 lg:w--9 lg:h--9" src="{{ hour.icon_url }}" alt="{{ hour.condition | escape }}">
            <span class="value value--xxsmall">{{ hour.temperature }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% else %}<span class="label">Hourly forecast unavailable</span>{% endif %}
  </div>
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
