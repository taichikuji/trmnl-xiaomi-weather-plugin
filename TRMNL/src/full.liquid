{% if available %}
<div class="layout layout--col layout--top {% if stale or alert_count > 0 %}gap--none lg:gap--small{% else %}gap--small{% endif %}">
  <div class="flex flex--row flex--between w--full">
    <span class="title grow" data-clamp="1">{{ city | escape }}</span>
    <span class="label no-shrink">{{ date_label | escape }} · {{ unit }}</span>
  </div>
  {{ provider_notice }}
  <div class="grid grid--cols-12 portrait:grid--cols-1 gap--small lg:gap--large grow">
    <div class="col--span-6 portrait:col--span-1 flex flex--col gap--xsmall lg:gap--medium self--center portrait:grid portrait:grid--cols-2">
      {% render 'weather_current', now: now, days: days, size: 'value--xxlarge portrait:w--full lg:value--giga lg:portrait:value--xxxlarge', large_details: true, icon_class: 'w--20 h--20 lg:w--40 lg:h--40 lg:portrait:w--24 lg:portrait:h--24', row_class: 'portrait:flex--col-reverse portrait:w--full' %}
      <div class="grid grid--cols-2 gap--xsmall portrait:self--center">
        <div class="outline p--2 flex flex--col gap--none">
          <span class="label">WIND</span>
          <span class="label">{{ now.wind }} {{ now.wind_unit | escape }} {{ now.wind_direction }}</span>
        </div>
        <div class="outline p--2 flex flex--col gap--none">
          <span class="label">HUMIDITY</span>
          <span class="label">{{ now.humidity }} · UV {{ now.uv }}</span>
        </div>
        <div class="outline p--2 flex flex--row flex--between col--span-2 gap--xsmall">
          <span class="label">Sunrise {{ sunrise }}</span>
          <span class="label">Sunset {{ sunset }}</span>
        </div>
      </div>
    </div>
    <div class="col--span-6 portrait:col--span-1 outline p--1 lg:p--4 flex flex--col gap--none flex--between">
      {% render 'weather_forecast', days: days, count: 5, icon_class: 'w--7 h--7 lg:w--14 lg:h--14 lg:portrait:w--10 lg:portrait:h--10' %}
    </div>
  </div>
  <div class="outline p--1 lg:p--4 flex flex--col gap--none w--full no-shrink">
    <div class="flex flex--row flex--between w--full">
      <span class="label">HOURLY FORECAST</span>
      <span class="label">Low {{ chart.low }} · High {{ chart.high }}</span>
    </div>
    {% if hours.size > 0 %}
    <div class="grid grid--cols-3 gap--small">
      <div class="col--span-1">{{ hourly_chart }}</div>
      <div class="col--span-2">
        <div class="grid grid--cols-6 gap--xsmall">
          {% for hour in hours %}
          <div class="flex flex--col flex--center gap--none">
            <span class="label lg:label--large">{{ hour.time }}</span>
            <img class="w--7 h--7 lg:w--14 lg:h--14 lg:portrait:w--12 lg:portrait:h--12" src="{{ hour.icon_url }}" alt="{{ hour.condition | escape }}">
            <span class="value value--xsmall lg:value--small">{{ hour.temperature }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% else %}<span class="label">Hourly forecast unavailable</span>{% endif %}
  </div>
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
