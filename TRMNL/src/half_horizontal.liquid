{% if available %}
<div class="layout layout--col gap--small">
  <div class="grid grid--cols-12 gap--medium">
    <div class="col--span-5 flex flex--col flex--left gap--small">
      <span class="title lg:title--large w--full" data-clamp="1">{{ city | escape }}</span>
      <div class="flex flex--row flex--center-y gap--medium">
        <span class="value value--xlarge lg:value--xxxlarge" data-fit-value="true">{% render 'weather_value', value: now.temperature, unit: '°', fahrenheit: fahrenheit %}</span>
        <div class="w--16 h--16 lg:w--24 lg:h--24 no-shrink"><img class="w--full h--full" src="{{ now.icon_url }}" alt="{{ now.condition | escape }}"></div>
      </div>
      <span class="label w--full" data-clamp="1">{{ now.condition | escape }} · Feels {% render 'weather_value', value: now.feels_like, unit: '°', fahrenheit: fahrenheit %}</span>
    </div>
    <div class="col--span-7 grid grid--cols-3 gap--small border--v-10 pl--3">
      {% for day in days limit:3 %}
      <div class="flex flex--col flex--center gap--small">
        <span class="label text--bold">{% render 'weather_day_label', day: day %}</span>
        <div class="w--12 h--12 lg:w--20 lg:h--20"><img class="w--full h--full" src="{{ day.icon_url }}" alt="{{ day.condition | escape }}"></div>
        <span class="value value--small lg:value--large">{% render 'weather_value', value: day.high, unit: '°', fahrenheit: fahrenheit %} <span class="label label--large">/ {% render 'weather_value', value: day.low, unit: '°', fahrenheit: fahrenheit %}</span></span>
        <span class="label">Precip. {% render 'weather_value', value: day.rain, unit: '%' %}</span>
      </div>
      {% else %}<span class="label col--span-3">Daily forecast unavailable</span>{% endfor %}
    </div>
  </div>
  {% if stale %}<span class="label label--outline w--full">Old observation · {{ observed_date }}</span>
  {% elsif alert_count > 0 %}<span class="label label--filled w--full" data-clamp="1">Provider alert · {{ alert_title | escape }} ({{ alert_count }})</span>{% endif %}
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
