{% if available %}
<div class="layout layout--col gap--small">
  <div class="grid grid--cols-12 gap--medium">
    <div class="col--span-5 lg:portrait:col--span-4 flex flex--col flex--left gap--small">
      <span class="title lg:title--large w--full" data-clamp="1">{{ city | escape }}</span>
      <div class="flex flex--row lg:portrait:flex--col flex--center-y gap--medium">
        <div class="grow w--min-0">
          <span class="value value--xlarge lg:value--xxxlarge" data-value-fit="true">{{ now.temperature }}</span>
        </div>
        <div class="w--16 h--16 lg:w--24 lg:h--24 no-shrink"><img class="w--full h--full" src="{{ now.icon_url }}" alt="{{ now.condition | escape }}"></div>
      </div>
      <span class="label lg:label--xlarge w--full" data-clamp="1" data-clamp-lg="2">{{ now.condition | escape }} · Feels {{ now.feels_like }}</span>
    </div>
    <div class="col--span-7 lg:portrait:col--span-8 grid grid--cols-3 gap--small border--v-10 pl--3">
      {% for day in days limit:3 %}
      <div class="flex flex--col flex--center gap--small lg:portrait:gap--large">
        <span class="label lg:label--xlarge text--bold">{{ day.label }}</span>
        <div class="w--12 h--12 lg:w--20 lg:h--20"><img class="w--full h--full" src="{{ day.icon_url }}" alt="{{ day.condition | escape }}"></div>
        <span class="value value--small lg:value--large">{{ day.high }} <span class="label label--large">/ {{ day.low }}</span></span>
        <span class="label lg:label--xlarge">Precip. {{ day.rain }}</span>
      </div>
      {% else %}<span class="label lg:label--xlarge col--span-3">Daily forecast unavailable</span>{% endfor %}
    </div>
  </div>
  {% if stale %}<span class="label lg:label--xlarge label--outline w--full">Old observation · {{ observed_date }}</span>
  {% elsif alert_count > 0 %}<span class="label lg:label--xlarge label--filled w--full" data-clamp="1">Provider alert · {{ alert_title | escape }} ({{ alert_count }})</span>{% endif %}
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
