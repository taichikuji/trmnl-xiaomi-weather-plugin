{% if available %}
<div class="layout layout--col gap--small">
  <div class="flex flex--row flex--between w--full">
    <span class="title lg:title--large grow" data-clamp="1">{{ city | escape }}</span>
    {% if stale %}<span class="label label--outline no-shrink">Old data</span>{% elsif alert_count > 0 %}<span class="label label--filled no-shrink">{{ alert_count }} alerts</span>{% endif %}
  </div>
  <div class="flex flex--row flex--center-y flex--between w--full">
    <div class="grow w--min-0">
      <span class="value value--xlarge lg:value--xxxlarge" data-value-fit="true">{{ now.temperature }}</span>
    </div>
    <div class="w--16 h--16 lg:w--24 lg:h--24 no-shrink"><img class="w--full h--full" src="{{ now.icon_url }}" alt="{{ now.condition | escape }}"></div>
  </div>
  <span class="label label--large w--full" data-clamp="1">{{ now.condition | escape }} · Feels {{ now.feels_like }}</span>
  <div class="hidden lg:visible w--full">
    <div class="grid grid--cols-2 gap--small">
      <span class="label">Wind {{ now.wind }} {{ now.wind_unit | escape }} {{ now.wind_direction }}</span>
      <span class="label">Humidity {{ now.humidity }}</span>
      {% if days.size > 0 %}
      <span class="label">High {{ days[0].high }} / Low {{ days[0].low }}</span>
      <span class="label">Precip. {{ days[0].rain }}</span>
      {% endif %}
      <span class="label">Sunrise {{ sunrise }}</span>
      <span class="label">Sunset {{ sunset }}</span>
    </div>
  </div>
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
