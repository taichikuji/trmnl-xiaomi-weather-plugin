{% if available %}
<div class="layout layout--col gap--xsmall">
  <div class="flex flex--row flex--between w--full">
    <span class="title grow" data-clamp="1">{{ city | escape }}</span>
    {% if stale %}<span class="label label--outline no-shrink">Old data</span>{% elsif alert_count > 0 %}<span class="label label--filled no-shrink">{{ alert_count }} alerts</span>{% endif %}
  </div>
  <div class="flex flex--col flex--center grow w--full">
    {% render 'weather_current', now: now, days: days, size: 'value--xlarge lg:value--xxxlarge', range_class: 'hidden lg:inline' %}
  </div>
  <div class="hidden lg:visible w--full">
    <div class="outline p--2 grid grid--cols-2 gap--small">
      <span class="label">Wind {{ now.wind }} {{ now.wind_unit | escape }} {{ now.wind_direction }}</span>
      <span class="label">Humidity {{ now.humidity }}</span>
      {% if days.size > 0 %}<span class="label">Precip. {{ days[0].rain }}</span>{% endif %}
      <span class="label">Sunrise {{ sunrise }}</span>
      <span class="label">Sunset {{ sunset }}</span>
    </div>
  </div>
</div>
{% else %}{{ weather_error }}{% endif %}
{{ weather_footer }}
